# Copy this file to .env and fill in your own value. .env is git-ignored.
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=replace-me

# Required while live.enabled is true: the final four digits of your account.
# Keep the actual value only in .env or the process environment.
BROKER_ACCOUNT_LAST4=

# Optional public macro data for the weekly dashboard; keep the real key in .env / Actions secrets.
FRED_API_KEY=

# Local private dashboard only; not used by the public GitHub workflows.
MASSIVE_API_KEY=
# Required for SEC filings: project name and your real contact email.
SEC_USER_AGENT=
